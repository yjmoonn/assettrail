{
  "name": "assettrail",
  "version": "1.0.0",
  "description": "AssetTrail static finance tracker",
  "private": true,
  "scripts": {
    "check:js": "node --check decision-engine.js && node --check action-engine.js && node --check ledger-engine.js && node --check app.js",
    "test:decision": "node tests/decision-engine.test.mjs",
    "test:action": "node tests/action-engine.test.mjs",
    "test:action-app": "node tests/app-action-support.test.mjs",
    "test:ledger": "node tests/ledger-engine.test.mjs && node tests/app-ledger.test.mjs",
    "test:investment": "node tests/app-investment-decisions.test.mjs",
    "test:cloud-conflict": "node tests/app-cloud-conflict.test.mjs",
    "test:cloud": "node tests/app-cloud-sync.test.mjs",
    "test:cloud-prices": "node tests/app-cloud-prices.test.mjs",
    "test:data": "node tests/app-data-durability.test.mjs",
    "test:price-fallback": "node tests/app-price-fallback.test.mjs",
    "test:prices": "node tests/app-prices.test.mjs",
    "test:symbols": "node tests/app-symbols.test.mjs",
    "test:price-requests": "python3 tests/generate-prices-requests.test.py",
    "test:firestore": "firebase emulators:exec --only firestore \"node tests/firestore-rules.test.mjs\"",
    "test": "npm run check:js && npm run test:decision && npm run test:action && npm run test:action-app && npm run test:ledger && npm run test:investment && npm run test:prices && npm run test:price-fallback && npm run test:symbols && npm run test:cloud && npm run test:cloud-conflict && npm run test:cloud-prices && npm run test:data && npm run test:price-requests && npm run test:firestore"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yjmoonn/assettrail.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/yjmoonn/assettrail/issues"
  },
  "homepage": "https://github.com/yjmoonn/assettrail#readme",
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "firebase": "^12.13.0",
    "firebase-tools": "^15.25.0",
    "jsdom": "^29.1.1"
  }
}
